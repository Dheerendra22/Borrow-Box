# Copy this file to .env and fill in the values marked with <FILL IN>

# Port the Express server listens on
PORT=5000

# Your MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=<FILL IN>

# A long random string used to sign JWT tokens — keep this secret!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<FILL IN>

# How long a token stays valid (7d = 7 days, 1h = 1 hour, etc.)
JWT_EXPIRES_IN=7d

# URL of the React frontend — used for CORS
CLIENT_URL=http://localhost:5173
